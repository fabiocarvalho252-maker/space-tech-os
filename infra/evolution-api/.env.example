# Copy this file to .env and fill in real values. Never commit .env.
# This stack is isolated from infra/supabase — separate Postgres, separate
# network, separate volumes.

# --- evolution-postgres ---
POSTGRES_DATABASE=evolution
POSTGRES_USERNAME=evolution
POSTGRES_PASSWORD=

# --- api (Evolution API itself) ---
# Public-facing address of this Evolution API instance. Only needs to be
# reachable from wherever SPACE TECH OS runs (same host here: localhost:8085
# per the port mapping in docker-compose.yml).
SERVER_URL=http://localhost:8085
# Global API key — put this same value in the app's own .env as
# EVOLUTION_API_KEY.
AUTHENTICATION_API_KEY=

# Must match POSTGRES_USERNAME/PASSWORD/DATABASE above; "evolution-postgres"
# is the service name on the evolution-net docker network.
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:CHANGE_ME@evolution-postgres:5432/evolution?schema=evolution_api
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true

# No Redis in this minimal single-instance setup — local in-process cache is
# enough for one instance being tested locally.
CACHE_REDIS_ENABLED=false
CACHE_LOCAL_ENABLED=true

# Webhooks are registered per-instance by the app itself (see
# src/lib/whatsapp/evolution-api.ts), not globally.
WEBHOOK_GLOBAL_ENABLED=false

LOG_LEVEL=ERROR,WARN,INFO
LOG_COLOR=true
