# Copy this file to .env and fill in real values. Never commit .env.

# Self-hosted Supabase stack (see infra/supabase/.env for the stack's own secrets)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# SMTP (transactional email, Hostinger). Até as 5 variáveis estarem
# preenchidas, o app roda normalmente e src/lib/email.ts reporta
# "SMTP não configurado."
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=spacetech@srmpretech.online
SMTP_PASSWORD=
SMTP_FROM=spacetech@srmpretech.online
