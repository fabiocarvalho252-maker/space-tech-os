# Copy this file to .env and fill in real values. Never commit .env.

# Self-hosted Supabase stack (see infra/supabase/.env for the stack's own secrets)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# SMTP (transactional email, Hostinger). Até as 5 variáveis estarem
# preenchidas, o app roda normalmente e src/lib/email.ts reporta
# "SMTP não configurado."
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=spacetech@srmpretech.online
SMTP_PASSWORD=
SMTP_FROM=spacetech@srmpretech.online

# SPACE TECH IA (assistente de chat, ver src/lib/ai/). Server-side only —
# nunca é exposta ao navegador. Sem AI_API_KEY o chat funciona normalmente e
# mostra "IA indisponível" em vez de travar.
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5
AI_API_KEY=

# Evolution API (integração WhatsApp, ver src/lib/whatsapp/). Server-side
# only — chamada apenas por src/lib/whatsapp/evolution-api.ts, nunca pelo
# navegador. NUNCA prefixar essas variáveis com VITE_ (isso as exporia no
# bundle do cliente). Sem EVOLUTION_API_URL/EVOLUTION_API_KEY a tela WhatsApp
# funciona normalmente e mostra "Evolution API não configurada".
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# Prefixo usado para nomear a instância de cada empresa nesta Evolution API
# (nome final: "<prefixo>_<user_id sem hifens>"). Não precisa mudar em
# instalações single-tenant; existe para diferenciar instâncias quando o
# mesmo servidor Evolution é compartilhado por mais de um ambiente/projeto.
EVOLUTION_INSTANCE=spacetech
# Segredo compartilhado exigido na URL do webhook (?token=...) que a
# Evolution API chama de volta em POST /api/whatsapp/webhook. Gere um valor
# aleatório (ex.: openssl rand -hex 32) — sem ele o webhook rejeita toda
# chamada (falha fechado), então preencha antes de conectar um WhatsApp real.
EVOLUTION_WEBHOOK_TOKEN=
