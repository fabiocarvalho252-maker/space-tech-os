# Copy this file to .env and fill in real values. Never commit .env.

# Self-hosted Supabase stack (see infra/supabase/.env for the stack's own secrets)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Public domain for customer-facing links (QR code, password-reset e-mail,
# etc). Optional — falls back to window.location.origin when unset.
VITE_SITE_URL=

# SMTP (transactional email, Hostinger). Até as 5 variáveis estarem
# preenchidas, o app roda normalmente e src/lib/email.ts reporta
# "SMTP não configurado."
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=spacetech@srmpretech.online
SMTP_PASSWORD=
SMTP_FROM=spacetech@srmpretech.online

# SPACE TECH IA (assistente de chat, ver src/lib/ai/). Server-side only —
# nunca é exposta ao navegador. Sem AI_API_KEY o chat funciona normalmente e
# mostra "IA indisponível" em vez de travar.
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5
AI_API_KEY=

# Evolution API (integração WhatsApp, ver src/lib/whatsapp/). Server-side
# only — chamada apenas por src/lib/whatsapp/evolution-api.ts, nunca pelo
# navegador. NUNCA prefixar essas variáveis com VITE_ (isso as exporia no
# bundle do cliente). Sem EVOLUTION_API_URL/EVOLUTION_API_KEY a tela WhatsApp
# funciona normalmente e mostra "Evolution API não configurada".
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# Prefixo usado para nomear a instância de cada empresa nesta Evolution API
# (nome final: "<prefixo>_<user_id sem hifens>"). Não precisa mudar em
# instalações single-tenant; existe para diferenciar instâncias quando o
# mesmo servidor Evolution é compartilhado por mais de um ambiente/projeto.
EVOLUTION_INSTANCE=spacetech
# Segredo compartilhado exigido na URL do webhook (?token=...) que a
# Evolution API chama de volta em POST /api/whatsapp/webhook. Gere um valor
# aleatório (ex.: openssl rand -hex 32) — sem ele o webhook rejeita toda
# chamada (falha fechado), então preencha antes de conectar um WhatsApp real.
EVOLUTION_WEBHOOK_TOKEN=
# Opcional: só necessário quando a Evolution API não enxerga esta app pela
# mesma origem que o navegador usa (ex.: Evolution API rodando num container
# Docker chamando de volta um app rodando no host — "localhost" de dentro do
# container não é o host). Nesse caso, aponte para um endereço que o
# servidor Evolution realmente alcance (ex.: http://host.docker.internal:8080).
# Deixe vazio em produção normal, onde a origem pública já é alcançável.
EVOLUTION_WEBHOOK_BASE_URL=

# Mercado Pago — assinatura SaaS da PRÓPRIA SPACE TECH (a plataforma
# cobrando a empresa cliente pelo plano Básico/Profissional). Não confundir
# com pagamento_config (Configurações → Mercado Pago dentro do app), que é
# o Mercado Pago de CADA EMPRESA CLIENTE para cobrar os clientes dela — são
# contas e tokens completamente diferentes. Ver src/lib/mercadopago/ e
# docs/mercado-pago.md. Sem ACCESS_TOKEN, contratar um plano retorna "Mercado
# Pago não configurado" em vez de travar — e enquanto o preço do plano
# estiver NULL, nenhuma chamada ao Mercado Pago é feita de qualquer forma.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Gere em Suas integrações → Notificações webhook, no painel do Mercado
# Pago. Sem isso o webhook processa normalmente mas pula a validação de
# x-signature (loga um aviso) — a segurança real vem de nunca confiar no
# corpo do webhook e sempre reconsultar o pagamento/assinatura direto na
# API do Mercado Pago antes de mudar qualquer status.
MERCADOPAGO_WEBHOOK_SECRET=
# "test" usa as credenciais de teste da sua Application no Mercado Pago
# (nenhum dinheiro real se move); troque para "production" só quando tiver
# credenciais de produção — nunca automaticamente.
MERCADOPAGO_ENVIRONMENT=test
