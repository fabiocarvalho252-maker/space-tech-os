# Modelo de /etc/office-runner.env. Copie para o servidor e preencha os valores.
# Segredos ficam VAZIOS aqui: nunca grave chaves reais neste arquivo.
# Permissão esperada no servidor: 600, dono root.

# Porta local do runner (escuta só em 127.0.0.1; o Nginx é a frente pública).
PORT=4317

# URL do projeto Supabase (self-hosted nesta máquina).
SUPABASE_URL=
# Chave anon do Supabase (pública no front, mas aqui é usada para validar tokens).
SUPABASE_ANON_KEY=
# Service role: grava o histórico no banco. Opcional; sem ela roda só em memória.
SUPABASE_SERVICE_ROLE_KEY=

# E-mail do único operador autorizado a usar o Escritório IA.
ADMIN_EMAIL=admin@spacetech.app
# Origem do site permitida para o front (CORS).
ALLOWED_ORIGIN=https://srmpretech.online

# Pasta raiz dos projetos que os agentes podem tocar.
OFFICE_PROJECTS_ROOT=/srv/office/projects
# Pasta .claude usada pelo SDK (login do plano Pro, sem chave de API).
OFFICE_CLAUDE_HOME=/srv/office/home/.claude

# Missões executadas em paralelo (1 recomendado para um VPS pequeno).
OFFICE_MAX_CONCURRENCY=1
# Teto de custo por missão, em USD.
OFFICE_MAX_COST_USD=3
# Tempo máximo de cada missão, em minutos.
OFFICE_MAX_MINUTES=30
# Número máximo de turnos do agente por missão.
OFFICE_MAX_TURNS=10
# Missões criadas por dia (UTC).
OFFICE_MAX_MISSOES_DIA=3
# Minutos até uma aprovação pendente expirar sem resposta.
OFFICE_APPROVAL_TIMEOUT_MIN=10
